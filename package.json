{
  "name": "ascend",
  "description": "日历驱动的多用户备考学习系统",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhangZhuorui5850/Ascend.git"
  },
  "homepage": "https://ascend.zhuorui.me",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "ascend": "tsx scripts/ascend-cli.ts",
    "mcp:ascend": "tsx scripts/ascend-mcp.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "up": "next build && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test": "vitest run",
    "docs:agent-operations": "tsx scripts/generate-agent-operation-docs.ts",
    "docs:agent-operations:check": "tsx scripts/generate-agent-operation-docs.ts --check",
    "docs:check": "node scripts/docs-check.mjs && tsx scripts/generate-agent-operation-docs.ts --check && node scripts/sync-agent-skills.mjs --check",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "ci:e2e": "node scripts/ci-e2e.mjs",
    "responsive:audit": "node scripts/responsive-audit.mjs",
    "audit:multi-user": "node scripts/multi-user-audit.mjs",
    "audit:offline-review": "node scripts/offline-review-audit.mjs",
    "audit:motion": "node scripts/motion-audit.mjs",
    "audit:plugin-algorithms": "node scripts/plugin-algorithm-audit.mjs",
    "audit:judge-host": "node scripts/judge-host-preflight.mjs",
    "audit:judge-staging": "node scripts/judge-staging-verify.mjs",
    "audit:judge-chain": "node scripts/judge-chain-audit.mjs",
    "audit:judge-isolation": "node scripts/judge-isolation-audit.mjs",
    "audit:algorithm-devices": "node scripts/algorithm-device-evidence.mjs",
    "css:audit": "node scripts/css-audit.mjs",
    "verify:migration": "node scripts/verify-workspace-migration.mjs",
    "verify:planner-migration": "node scripts/verify-planner-migration.mjs",
    "worker:reminders": "tsx scripts/planner-reminder-worker.ts",
    "smoke": "node scripts/smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verified": "node scripts/backup-verified.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "gc:blobs": "node scripts/gc-blobs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@date-fns/tz": "^1.5.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.23.0",
    "luxon": "^3.7.2",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rrule": "^2.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}

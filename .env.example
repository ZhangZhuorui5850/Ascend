APP_LOGIN_EMAIL=owner@example.com
APP_LOGIN_PASSWORD=change-this-password
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
ZGCA_BACKUP_ROOT=/app/backups
# 可选：挂载到另一块磁盘、NAS 或同步目录，备份成功后复制一份完整快照。
ZGCA_BACKUP_MIRROR_ROOT=
# 可选：仅在完整备份验证成功后 POST 的 HTTPS dead-man URL，不要提交真实地址。
ZGCA_BACKUP_SUCCESS_URL=

# Ascend CLI / 本地 MCP：多账号时必须指定要操作的普通学习账号。
ASCEND_AGENT_EMAIL=owner@example.com
# 资料导入白名单，多个绝对路径用英文逗号分隔；未设置时只允许当前项目目录。
ASCEND_AGENT_IMPORT_ROOTS=/path/to/allowed/imports
# 算法题目录扫描白名单，多个绝对路径用英文逗号分隔。
# 配置目录中的 C++ 题目可通过服务端批量导入；日常导入使用「算法训练 → 添加 CPP」。
ASCEND_ALGORITHM_IMPORT_ROOTS=/path/to/algorithm
# 记录超过该毫秒数的同步 SQLite prepared query；只记指纹和耗时，不记参数。
ZGCA_SLOW_QUERY_MS=20

# 在线算法评测：主应用只连接独立 Judge Gateway，绝不能把不可信代码放在本容器执行。
# 生产必须使用 HTTPS；token 与 Gateway 端保持一致，并使用独立 secret 管理。
ASCEND_JUDGE_GATEWAY_URL=
ASCEND_JUDGE_GATEWAY_TOKEN=
ASCEND_JUDGE_GATEWAY_TIMEOUT_MS=5000
# 生成方式：openssl rand -base64 32。必须是独立于登录、数据库和 Judge token 的 32 字节密钥。
ASCEND_JUDGE_CODE_KEY=
ASCEND_JUDGE_CODE_KEY_VERSION=1
# 轮换后仅为解密保留的旧密钥，例如 {"1":"old-base64"}；最多 10 个版本。
ASCEND_JUDGE_CODE_PREVIOUS_KEYS_JSON={}
# 0 表示评测终态后立即密文擦除；确有复查需要时才提高，范围 0-365。
ASCEND_JUDGE_CODE_RETENTION_DAYS=0
# 小规模试点期间设为 true：仅明确申请且经管理员批准的工作区可提交/轮询在线评测。
# 题目、提示和加密草稿不受此开关影响。
ASCEND_JUDGE_PILOT_REQUIRED=true

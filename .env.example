APP_LOGIN_EMAIL=owner@example.com
APP_LOGIN_PASSWORD=change-this-password
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
ZGCA_BACKUP_ROOT=/app/backups
# 可选：挂载到另一块磁盘、NAS 或同步目录，备份成功后复制一份完整快照。
ZGCA_BACKUP_MIRROR_ROOT=

# Ascend CLI / 本地 MCP：多账号时必须指定要操作的普通学习账号。
ASCEND_AGENT_EMAIL=owner@example.com
# 资料导入白名单，多个绝对路径用英文逗号分隔；未设置时只允许当前项目目录。
ASCEND_AGENT_IMPORT_ROOTS=/path/to/allowed/imports

APP_DOMAIN=ascend.zhuorui.me
ACME_EMAIL=replace-with-your-email@example.com

APP_LOGIN_EMAIL=owner@example.com
APP_LOGIN_PASSWORD=replace-with-a-strong-owner-password
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-different-bootstrap-password

ZGCA_BACKUP_ROOT=/app/backups
# 备份保留天数（超期的日期目录会被 backup.mjs 自动清理）
ZGCA_BACKUP_KEEP=14

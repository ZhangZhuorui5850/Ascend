APP_DOMAIN=ascend.zhuorui.me
ACME_EMAIL=replace-with-your-email@example.com

APP_LOGIN_EMAIL=owner@example.com
APP_LOGIN_PASSWORD=replace-with-a-strong-owner-password
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-different-bootstrap-password

ZGCA_BACKUP_ROOT=/app/backups
# 备份保留天数（超期的日期目录会被 backup.mjs 自动清理）
ZGCA_BACKUP_KEEP=14
# 最近一次完成“附件 hash + DB 引用 + 隔离恢复”验证的快照超过该时长后，health 标记 stale。
ZGCA_BACKUP_MAX_AGE_HOURS=36
# 确认定时备份稳定后可设为 1；此时未验证或过期备份会让 readiness 返回 503。
ZGCA_REQUIRE_FRESH_BACKUP=0
ZGCA_SLOW_QUERY_MS=20
# 可选：容器内异地挂载点。必须通过 Compose override 把另一块磁盘/NFS 挂到该路径。
ZGCA_BACKUP_MIRROR_ROOT=
# 可选：仅在 backup + verify + 隔离恢复全部成功后 POST；应使用专用 HTTPS dead-man URL。
ZGCA_BACKUP_SUCCESS_URL=
# 每次构建/发布前由 `export ASCEND_APP_COMMIT=$(git rev-parse HEAD)` 注入，不要手写旧值。
ASCEND_APP_COMMIT=unknown

# 独立在线评测服务。生产 URL 必须是 HTTPS，Gateway/Worker 不得与 Ascend 共享数据卷或 secret。
ASCEND_JUDGE_GATEWAY_URL=
ASCEND_JUDGE_GATEWAY_TOKEN=
ASCEND_JUDGE_GATEWAY_TIMEOUT_MS=5000
# `openssl rand -base64 32`；不要复用登录密码、session secret 或 Gateway token。
ASCEND_JUDGE_CODE_KEY=
ASCEND_JUDGE_CODE_KEY_VERSION=1
# 轮换窗口内的旧密钥版本到 Base64 的 JSON 映射；不再需要后应从 secret 中移除。
ASCEND_JUDGE_CODE_PREVIOUS_KEYS_JSON={}
# 默认终态即擦除源码密文；如调整，需同时更新隐私说明和备份/导出审查。
ASCEND_JUDGE_CODE_RETENTION_DAYS=0

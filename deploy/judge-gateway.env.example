# 此文件用于独立 Judge Gateway 主机，不应复制 Ascend 主应用的数据库或登录 secret。
ASCEND_JUDGE_GATEWAY_TOKEN=replace-with-at-least-32-random-bytes
ASCEND_JUDGE_GATEWAY_PORT=4100
ASCEND_JUDGE_GATEWAY_DATA=/var/lib/ascend-judge-gateway
ASCEND_JUDGE_PROBLEMS_FILE=/gateway/services/judge-gateway/problems.json
ASCEND_JUDGE_MAX_ACTIVE=100
ASCEND_JUDGE_MAX_DAILY=10000

# 指向有独立安全边界的 Judge0 API。语言 ID 必须从该实例 /languages 实测，不可照抄示例值。
JUDGE0_URL=https://judge0.internal.example
JUDGE0_AUTH_TOKEN=replace-with-dedicated-judge0-token
JUDGE0_LANGUAGE_IDS_JSON={"cpp17":54,"python3":71}

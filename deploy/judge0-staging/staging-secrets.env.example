# Copy to staging-secrets.env and chmod 600. Compose uses these only for
# interpolation; each service receives only the variables it actually needs.
JUDGE0_AUTH_TOKEN=replace-with-judge0-auth-token-at-least-32-bytes
REDIS_PASSWORD=replace-with-distinct-redis-password-at-least-32-bytes
POSTGRES_PASSWORD=replace-with-distinct-postgres-password-at-least-32-bytes
SECRET_KEY_BASE=replace-with-independent-secret-key-base-at-least-64-bytes
ASCEND_JUDGE_GATEWAY_TOKEN=replace-with-gateway-token-at-least-32-bytes
# Must be checked against this instance's authenticated /languages response.
JUDGE0_LANGUAGE_IDS_JSON={"cpp17":54,"python3":71}
